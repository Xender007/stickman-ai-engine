{
  "name": "stickman-story",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "make": "tsx --env-file-if-exists=.env scripts/make.ts",
    "stills": "tsx scripts/stills.ts",
    "sfx": "python3 scripts/make_sfx.py",
    "test": "tsx scripts/test.ts && tsc --noEmit",
    "test:engine": "node --import tsx --test \"packages/**/*.test.ts\"",
    "engine": "tsx apps/engine-cli/src/cli.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "@remotion/bundler": "^4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/noise": "4.0.537",
    "@remotion/renderer": "^4.0.537",
    "@remotion/three": "4.0.537",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.537",
    "three": "0.170.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.1.8",
    "@types/three": "^0.170.0",
    "tsx": "^4.23.15",
    "typescript": "5.8.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
