{
 "audio": "episodes/the-quiet-coast/part-3.wav",
 "lines": [
  {
   "id": "P3-L01",
   "text": "The water drained out of the streets.",
   "start": 0.6,
   "end": 2.945
  },
  {
   "id": "P3-L02",
   "text": "Fifteen minutes. Maybe less.",
   "start": 3.386,
   "end": 6.359
  },
  {
   "id": "P3-L03",
   "text": "They waded through knee-deep mud.",
   "start": 6.859,
   "end": 9.077
  },
  {
   "id": "P3-L04",
   "text": "Mia slipped. Ravi pulled her up.",
   "start": 9.518,
   "end": 12.339
  },
  {
   "id": "P3-L05",
   "text": "The tower's main door was blocked.",
   "start": 12.738,
   "end": 14.781
  },
  {
   "id": "P3-L06",
   "text": "The fire stairs. Fourteen floors.",
   "start": 14.863,
   "end": 17.893
  },
  {
   "id": "P3-L07",
   "text": "Far out, the horizon turned white.",
   "start": 18.693,
   "end": 21.015
  },
  {
   "id": "P3-L08",
   "text": "“Don't look back,” Ravi said.",
   "start": 21.456,
   "end": 23.43
  },
  {
   "id": "P3-L09",
   "text": "Floor five. Floor six.",
   "start": 23.93,
   "end": 26.531
  },
  {
   "id": "P3-L10",
   "text": "Mia's legs gave out.",
   "start": 26.831,
   "end": 28.538
  },
  {
   "id": "P3-L11",
   "text": "He carried her the rest of the way.",
   "start": 28.781,
   "end": 30.871
  },
  {
   "id": "P3-L12",
   "text": "Floor twelve. The roar arrived.",
   "start": 31.371,
   "end": 34.541
  },
  {
   "id": "P3-L13",
   "text": "They reached the roof as the wave hit.",
   "start": 34.657,
   "end": 37.687
  },
  {
   "id": "P3-L14",
   "text": "Ravi threw himself over Mia.",
   "start": 38.587,
   "end": 40.584
  },
  {
   "id": "P3-L15",
   "text": "The wave exploded against the tower.",
   "start": 40.642,
   "end": 42.999
  },
  {
   "id": "P3-L16",
   "text": "Water climbed past floor after floor...",
   "start": 43.399,
   "end": 46.29
  },
  {
   "id": "P3-L17",
   "text": "and stopped two floors below them.",
   "start": 46.418,
   "end": 49.622
  },
  {
   "id": "P3-L18",
   "text": "Silence.",
   "start": 50.622,
   "end": 52.062
  },
  {
   "id": "P3-L19",
   "text": "They waited. Day one.",
   "start": 52.961,
   "end": 55.004
  },
  {
   "id": "P3-L20",
   "text": "Day two. The water began to fall.",
   "start": 55.505,
   "end": 59.127
  },
  {
   "id": "P3-L21",
   "text": "Day three. Nobody came.",
   "start": 59.627,
   "end": 62.924
  },
  {
   "id": "P3-L22",
   "text": "Then, on the third night, Mia heard something.",
   "start": 63.924,
   "end": 66.71
  },
  {
   "id": "P3-L23",
   "text": "Far away. High in the sky.",
   "start": 67.211,
   "end": 69.672
  },
  {
   "id": "P3-L24",
   "text": "Listen!",
   "start": 70.172,
   "end": 70.915
  },
  {
   "id": "P3-L25",
   "text": "She lifted the flashlight.",
   "start": 71.315,
   "end": 73.08
  },
  {
   "id": "P3-L26",
   "text": "Three short. Three long. Three short.",
   "start": 73.38,
   "end": 76.399
  },
  {
   "id": "P3-L27",
   "text": "A red helicopter broke through the clouds.",
   "start": 78.698,
   "end": 81.531
  },
  {
   "id": "P3-L28",
   "text": "Its searchlight blinked back.",
   "start": 82.031,
   "end": 84.028
  },
  {
   "id": "P3-L29",
   "text": "Same code.",
   "start": 84.528,
   "end": 85.968
  },
  {
   "id": "P3-L30",
   "text": "Help had finally come.",
   "start": 86.568,
   "end": 88.797
  }
 ],
