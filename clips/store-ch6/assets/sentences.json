{
 "engine": "kokoro",
 "total": 88.07108333333333,
 "sentences": [
  {
   "text": "That rule was written by someone who thought the problem was the door.",
   "start": 0.6,
   "end": 4.5333749999999995
  },
  {
   "text": "Aisle 14: ladders.",
   "start": 4.833374999999999,
   "end": 6.635041666666666
  },
  {
   "text": "You lower one off the roof.",
   "start": 6.935041666666666,
   "end": 8.503874999999999
  },
  {
   "text": "The girl climbs up.",
   "start": 8.803875,
   "end": 9.999958333333334
  },
  {
   "text": "In her backpack, one enormous orange cat.",
   "start": 10.299958333333333,
   "end": 12.953999999999999
  },
  {
   "text": "Then you prepare for the truck.",
   "start": 13.754,
   "end": 15.459583333333333
  },
  {
   "text": "You cannot stop four people.",
   "start": 15.759583333333332,
   "end": 17.436249999999998
  },
  {
   "text": "But you know what can.",
   "start": 17.73625,
   "end": 18.886041666666664
  },
  {
   "text": "Aisle 9.",
   "start": 19.186041666666664,
   "end": 19.99070833333333
  },
  {
   "text": "Thirty alarm clocks.",
   "start": 20.29070833333333,
   "end": 21.67770833333333
  },
  {
   "text": "Winding them takes one person thirty minutes.",
   "start": 21.977708333333332,
   "end": 24.552875
  },
  {
   "text": "Two people can do it in fifteen.",
   "start": 24.852874999999997,
   "end": 26.732916666666664
  },
  {
   "text": "You are starting to see the point of other people.",
   "start": 27.032916666666665,
   "end": 29.69908333333333
  },
  {
   "text": "At four, the truck backs up to the shutter.",
   "start": 29.99908333333333,
   "end": 32.18958333333333
  },
  {
   "text": "While the men drag out their chain, you lower the bucket one last time, straight into the bed of their truck.",
   "start": 32.48958333333333,
   "end": 38.80595833333333
  },
  {
   "text": "Thirty clocks, all set for 4:10.",
   "start": 39.10595833333333,
   "end": 41.28579166666666
  },
  {
   "text": "It is the loudest thing this city has heard in a month.",
   "start": 41.58579166666666,
   "end": 44.396833333333326
  },
  {
   "text": "Every dead thing for a mile turns toward it, toward the truck.",
   "start": 44.69683333333332,
   "end": 48.52141666666666
  },
  {
   "text": "The men do the smart thing.",
   "start": 48.82141666666666,
   "end": 50.35854166666666
  },
  {
   "text": "They drop the chain and drive.",
   "start": 50.65854166666666,
   "end": 52.41937499999999
  },
  {
   "text": "The noise goes with them.",
   "start": 52.71937499999999,
   "end": 54.16258333333332
  },
  {
   "text": "So does the crowd.",
   "start": 54.46258333333333,
   "end": 55.643249999999995
  },
  {
   "text": "By sunrise, the parking lot is empty.",
   "start": 55.94324999999999,
   "end": 58.41879166666666
  },
  {
   "text": "Day 28, inventory.",
   "start": 59.21879166666666,
   "end": 61.07991666666666
  },
  {
   "text": "People: two.",
   "start": 61.37991666666666,
   "end": 62.26324999999999
  },
  {
   "text": "Cats: one.",
   "start": 62.56324999999999,
   "end": 63.43433333333332
  },
  {
   "text": "Tins: plenty.",
   "start": 63.734333333333325,
   "end": 64.77879166666666
  },
  {
   "text": "Customers: 24 a night.",
   "start": 65.07879166666666,
   "end": 66.82708333333332
  },
  {
   "text": "This building holds enough food for a lifetime.",
   "start": 67.12708333333333,
   "end": 69.67904166666666
  },
  {
   "text": "Alone, you would not have made it to day 21.",
   "start": 69.97904166666666,
   "end": 72.624625
  },
  {
   "text": "You know that now.",
   "start": 72.92462499999999,
   "end": 73.96262499999999
  },
  {
   "text": "And every night at nine, a key scratches at the staff entrance.",
   "start": 74.26262499999999,
   "end": 77.99341666666665
  },
  {
   "text": "Rhea is starting her shift.",
   "start": 78.29341666666666,
   "end": 79.75379166666666
  },
  {
   "text": "She has never missed one.",
   "start": 80.05379166666665,
   "end": 81.44329166666665
  },
  {
   "text": "Neither have you.",
   "start": 81.74329166666665,
   "end": 82.77108333333332
  }
 ]
}